--as a analyst talk to experts show this scenario
--two solution --1. DAta issues will be fixed from source system
			   --2. Data issues has to be fixed in a dataware house


--tranformation rules 
/*  If sales is negative,zero,null, derive it using quantity and price
	If price is zero or null,calculate it using sales and quantity\
	If price is negative,convert it to a positive value

Case When 
			sales is  null or sales <= 0 OR sales!= quantity * abs(price)					---ABS func convert everthing from negative to positve
			THEn quantity * abs(price) Else sales
			*/
SELECT DISTINCT sls_sales as Old,sls_quantity,sls_price as oldprice,
		CASE    when sls_sales IS NULL OR sls_sales <= 0 OR sls_sales != sls_quantity * ABS(sls_price)
				THEN sls_quantity * ABS(sls_price)
				ELSE sls_sales
	End sls_sales,
	CASE		WHEN sls_price IS NULL OR sls_price <=0 THEN sls_sales / NullIf(sls_quantity,0)
				Else sls_price
	End as sls_price

FROM bronze.crm_sales_details
WHERE sls_sales != sls_quantity * sls_price
OR sls_sales IS NULL or sls_quantity IS NULL or sls_price is NULL
ORDER BY sls_sales,sls_quantity,sls_price


